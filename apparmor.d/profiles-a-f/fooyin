abi <abi/5.0>,

include <tunables/global>

@{exec_path} = @{bin}/fooyin
profile fooyin @{bin}/fooyin {
  include <abstractions/base>
  include <abstractions/audio-server>
  include <abstractions/desktop>
  include <abstractions/fontconfig-cache-read>
  include <abstractions/graphics>
  include <abstractions/nameservice-strict>
  include <abstractions/ssl_certs>
  include <abstractions/sys/dmi>

  network netlink raw,
  network inet dgram,
  network inet6 dgram,
  network inet stream,
  network inet6 stream,

  @{exec_path} rPx, # fooyin can execute itself after requesting app relaunch when a plugin is enabled/disabled

  /usr/share/fooyin/{,**} r,

  /dev/tty r,

  /etc/machine-id r,

  owner @{PROC}/@{pid}/task/@{tid}/comm w,

  owner @{user_music_dirs}/ r,
  owner @{user_music_dirs}/** rwl,

  owner @{run}/user/@{uid}/fooyin@{rand6}.@{int}.kioworker.socket rwl,
  owner @{run}/user/@{uid}/discord-ipc-0 rw,

  owner @{tmp}/kdsingleapp-@{uid}-fooyin rw,
  owner @{tmp}/kdsingleapp-@{uid}-fooyin.lock rwk,
  owner @{tmp}/kdsingleapp-@{uid}-fooyin.lock.rmlock rwk,
  owner @{tmp}/kdsingleapp-@{user}-fooyin.lock.rmlock rwk,
  owner @{tmp}/kdsingleapp-@{user}-fooyin rw,
  owner @{tmp}/kdsingleapp-@{user}-fooyin.lock rwk,
  owner /var/tmp/etilqs_@{hex16} rw,

  owner @{user_share_dirs}/fooyin/{,**} rw,
  owner @{user_share_dirs}/fooyin/fooyin.db k,
  owner @{user_share_dirs}/fooyin/radiobrowser.db k,

  owner @{user_config_dirs}/fooyinrc rw,
  owner @{user_config_dirs}/fooyinrc.lock rwk,
  owner @{user_config_dirs}/fooyin/{,**} rw,
  owner @{user_config_dirs}/fooyin/fooyin.conf.@{rand6} l,
  owner @{user_config_dirs}/fooyin/fooyin.conf.lock k,
  owner @{user_config_dirs}/fooyin/layouts/*.fyl.@{rand6} l,

  owner @{user_cache_dirs}/fooyin/{,**} rwlk,

  owner @{user_lib_dirs}/fooyin/{,**} rw,
  owner @{user_lib_dirs}/fooyin/plugins/*.so m,

  owner @{user_state_dirs}/#@{int8} rw,
  owner @{user_state_dirs}/fooyinstaterc rw,
  owner @{user_state_dirs}/fooyinstaterc.lock rwk,
  owner @{user_state_dirs}/fooyinstaterc.@{rand6} rwl,
  owner @{user_state_dirs}/fooyin/{,**} rw,
  owner @{user_state_dirs}/fooyin/fooyin.state.lock k,
  owner @{user_state_dirs}/fooyin/fooyin.state.@{rand6} l,

  include if exists <local/fooyin>
}
