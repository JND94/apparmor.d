#steam-launch
#├── steam-runtime-steam-remote
#├── steam.sh (bash)
#    ├──steam-executable32 #ignored, fallback?
#    ├──steam-executable64
#       ├──steam-pv-run (bash)
#          ├──steam-srt-client-container
#             ├──steam-client-runtime (pv-wrap)
#                ├──steam-client-bwrap (bwrap)
#                   ├──&steam-webhelper
#                   ├──&steam-hardware-updater
#                   ├──&steam-gameoverlayui
#             ├──steam-srt-launcher-service (bash)
#                ├──steam-fossilize-run (bash)
#                   ├──steam-fossilize-runtime (pv-wrap)
#                      ├──steam-fossilize-bwrap (bwrap)
#                ├──steam-game-run (reaper)
#                   ├──steam-game-runtime (pv-wrap)
#                      ├──steam-game-bwrap (bwrap)
#                         ├──&steam-game-proton

abi <abi/5.0>,

include <tunables/global>

@{share_dirs} = @{user_share_dirs}/Steam @{HOME}/.steam/debian-installation
@{steam_library} = @{share_dirs}/steamapps @{MOUNTS}/**/SteamLibrary/steamapps
@{app_dirs} = @{steam_library}/common
@{compatdata} = @{steam_library}/compatdata
@{runtime} = SteamLinuxRuntime SteamLinuxRuntime_sniper SteamLinuxRuntime_soldier SteamLinuxRuntime_4
@{proton_dirs} = @{app_dirs}/Proton*/ @{share_dirs}/compatibilitytools.d/*/
@{client_runtime} = @{share_dirs}/steamrt64/pv-runtime/steam-runtime-steamrt

@{exec_path} = @{share_dirs}/steam.sh
profile steam @{share_dirs}/steam.sh {
  include <abstractions/base>
  include <abstractions/consoles>
  include <abstractions/fontconfig-cache-write>

  @{exec_path} r,

  @{sh_path}        rix,
  @{coreutils_path} rix,
  @{bin}/ldd        rix,
  @{bin}/zenity     rcx -> zenity,
  @{bin}/xz         rix,

  owner @{client_runtime}/pressure-vessel/bin/steam-runtime-check-requirements rcx -> check,
  owner @{share_dirs}/ubuntu12_32/steam rpx, #steam-executable32
  owner @{share_dirs}/steamrt64/steam rpx, #steam-executable64

  owner @{share_dirs}/ rw,
  owner @{share_dirs}/** rwlk,
  owner @{HOME}/.steam/steam.pid rw,
  owner @{HOME}/.steam/bin rw,
  owner @{HOME}/.steam/starting rw,
  owner @{HOME}/.steampath rw,
  owner @{HOME}/.steampid rw,

  /etc/lsb-release r,

  owner /tmp/steam_message.txt rw,
  owner /tmp/tmp.@{rand10} rw,

  profile check flags=(complain) {
    include <abstractions/base>

    # TODO ?? 

    include if exists <local/steam_check>
  }

  profile zenity {
    include <abstractions/base>
    include <abstractions/bus-session>
    include <abstractions/wayland>
    include <abstractions/X-strict>

    include if exists <local/steam_zenity>
  }

  include if exists <local/steam>
}
