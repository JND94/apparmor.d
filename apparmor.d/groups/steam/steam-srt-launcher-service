abi <abi/5.0>,

include <tunables/global>

@{share_dirs} = @{user_share_dirs}/Steam @{HOME}/.steam/debian-installation
@{steam_library} = @{share_dirs}/steamapps @{MOUNTS}/**/SteamLibrary/steamapps
@{app_dirs} = @{steam_library}/common
@{compatdata} = @{steam_library}/compatdata
@{runtime} = SteamLinuxRuntime SteamLinuxRuntime_sniper SteamLinuxRuntime_soldier SteamLinuxRuntime_4
@{proton_dirs} = @{app_dirs}/Proton*/ @{share_dirs}/compatibilitytools.d/*/
@{client_runtime} = @{share_dirs}/steamrt64/pv-runtime/steam-runtime-steamrt

@{exec_path} = @{client_runtime}/pressure-vessel/libexec/steam-runtime-tools-0/@{multiarch}srt-launcher-service
profile steam-srt-launcher-service @{client_runtime}/pressure-vessel/libexec/steam-runtime-tools-0/@{multiarch}srt-launcher-service flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/consoles>
  include <abstractions/bus-session>

  unix type=stream addr="@*/bus/steam-launch-wr/",

  signal receive set=term peer=steam-srt-client-container,

  @{exec_path} rm,

  @{sh_path}      rix,
  @{bin}/lspci    rcx -> lspci,
  @{bin}/readlink rix, #_v2-entry-point
  @{bin}/getopt   rix, #_v2-entry-point
  @{bin}/shuf     rix,
  @{open_path}    rpx -> child-open,

  #steamfossilize
  owner @{app_dirs}/@{runtime}/_v2-entry-point rix,
  owner @{app_dirs}/@{runtime}/run rpx, #steam-fossilize-run

  #gamelaunch
  owner @{share_dirs}/steamrt64/steam-launch-wrapper rmix,
  owner @{share_dirs}/steamrt64/reaper rpx, #steam-game-run
  owner @{client_runtime}/pressure-vessel/bin/steam-runtime-supervisor rix,

  owner @{client_runtime}/pressure-vessel/lib/@{multiarch}/steam-runtime-tools-0/**.so* rm,

  owner @{share_dirs}/steamrt{32,64}/gameoverlayrenderer.so rm,

  @{lib}/gconv/gconv-modules.cache r,

  owner /dev/shm/u@{uid}-ValveIPCSharedObj-Steam rwk,
  owner /dev/shm/u@{uid}-Shm_* rw,

          /home/ r,
  owner @{HOME}/ r,
  owner @{HOME}/.local/ r,
  owner @{user_share_dirs}/ r,

  owner @{att}/tmp/SteamEnvFD@{rand6} rw,

  owner @{run}/user/@{uid}/systemd/private rw,

  profile lspci {
    include <abstractions/base>
    include <abstractions/nameservice-strict>

    @{bin}/lspci r,

    @{sys}/bus/pci/devices/ r,
    @{sys}/devices/@{pci}/config r,
    @{sys}/devices/@{pci}/vendor r,
    @{sys}/devices/@{pci}/device r,
    @{sys}/devices/@{pci}/class r,
    @{sys}/devices/@{pci}/revision r,
    @{sys}/devices/@{pci}/subsystem_vendor r,
    @{sys}/devices/@{pci}/subsystem_device r,

    include if exists <local/steam-srt-launcher-service_lspci>
  }

  include if exists <local/steam-srt-launcher-service>
}
