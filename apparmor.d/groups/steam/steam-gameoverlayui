abi <abi/5.0>,

include <tunables/global>

@{share_dirs} = @{user_share_dirs}/Steam @{HOME}/.steam/debian-installation
@{steam_library} = @{share_dirs}/steamapps @{MOUNTS}/**/SteamLibrary/steamapps
@{app_dirs} = @{steam_library}/common
@{compatdata} = @{steam_library}/compatdata
@{runtime} = SteamLinuxRuntime SteamLinuxRuntime_sniper SteamLinuxRuntime_soldier SteamLinuxRuntime_4
@{proton_dirs} = @{app_dirs}/Proton*/ @{share_dirs}/compatibilitytools.d/*/
@{client_runtime} = @{share_dirs}/steamrt64/pv-runtime/steam-runtime-steamrt

@{exec_path} = @{share_dirs}/steamrt64/gameoverlayui
profile steam-gameoverlayui @{share_dirs}/steamrt64/gameoverlayui flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/bus-session>
  include <abstractions/fonts>
  include <abstractions/nameservice-strict> #steamerrorreporter
  include <abstractions/ssl_certs> #steamerrorreporter
  include <abstractions/X-strict>

  #steamerrorreporter
  network inet dgram,
  network inet6 dgram,
  network inet stream,
  network inet6 stream,
  network netlink raw,

  network inet stream ip=127.0.0.1,

  ptrace (read, trace) peer=steam-client-bwrap//&steam-gameoverlayui,

  @{exec_path} r,

  owner @{share_dirs}/linux32/steamerrorreporter rix,

  owner /usr/share/fonts/** k,

  owner / r,
          /home/ r,
  owner @{HOME}/ r,
  owner @{HOME}/.steam/registry.vdf rk,
  owner @{share_dirs}/ r,
  owner @{share_dirs}/steamrt64/ r,
  owner @{share_dirs}/steamrt64/*.so* rm,
  owner @{lib}/@{multiarch}/libbrotlicommon.so* rm,
  owner @{share_dirs}/linux64/steamclient.so rm,
  owner @{share_dirs}/resource/{,**} r,
  owner @{share_dirs}/friends/{,**} r,
  owner @{share_dirs}/config/{,**} r,
  owner @{share_dirs}/config/DialogConfigOverlay_*.vdf rw,
  owner @{share_dirs}/public/{,**} r,

  owner /dev/shm/u@{uid}-ValveIPCSharedObj-Steam rwk,
  owner /dev/shm/ValveIPCSHM_@{uid} rw,
  owner /dev/shm/u@{uid}-Shm_* rw,

          /tmp/ r,
  owner @{tmp}/gameoverlay_ui.txt rw,
  owner @{tmp}/gameoverlay_ui.previous.txt rw,
  owner @{tmp}/steam_chrome_overlay_uid@{uid}_spid@{pid} rw,
  owner @{tmp}/steam_chrome_shmem_uid@{uid}_spid@{pid} rw,
  owner @{tmp}/dumps/assert_@{word16}.dmp rw,
  owner @{tmp}/dumps/@{user}_log.txt rw, #steamerrorreporter

        @{att}@{run}/dbus/system_bus_socket rw, # !!!
  owner @{att}@{run}/user/@{uid}/bus rw,

        @{run}/host@{lib}/**.so* rm,
        @{run}/host@{lib}/locale/locale-archive r,
        @{run}/host/share/icons/{,**} r,
        @{run}/host/fonts/{,**} rk,
        @{run}/host@{lib}/os-release r,
  owner @{run}/pressure-vessel/Xauthority r,

        @{PROC}/version r,
  owner @{PROC}/@{pid}/task/ r,
  owner @{PROC}/@{pid}/cmdline r,
  owner @{PROC}/@{pid}/environ r,

  owner /var/pressure-vessel/ldso/ld.so.cache r,

  @{sys}/ r,
  @{sys}/class/ r,
  @{sys}/class/drm/ r,
  @{sys}/class/hwmon/ r, 
  @{sys}/kernel/ r,
  @{sys}/devices/@{pci}/hwmon/ r,
  @{sys}/devices/@{pci}/hwmon/hwmon@{int}/ r,
  @{sys}/devices/system/cpu/cpufreq/policy@{int}/cpuinfo_max_freq rk,
  @{sys}/devices/system/cpu/cpufreq/policy@{int}/cpuinfo_min_freq rk,
  @{sys}/devices/system/cpu/cpufreq/policy@{int}/scaling_cur_freq rk,
  @{sys}/devices/@{pci}/hwmon/hwmon@{int}/temp@{int}_input rk,
  @{sys}/devices/virtual/thermal/thermal_zone@{int}/hwmon@{int}/temp@{int}_input rk,
  @{sys}/devices/@{pci}/hwmon/hwmon@{int}/temp@{int}_label rk,
  @{sys}/devices/@{pci}/gpu_busy_percent rk,
  @{sys}/devices/@{pci}/mem_info_vram_used rk,
  @{sys}/devices/@{pci}/mem_info_vram_total rk,
  @{sys}/devices/@{pci}/mem_info_gtt_used rk,
  @{sys}/devices/@{pci}/mem_info_gtt_total rk,
  @{sys}/devices/@{pci}/drm/card@{int}/card*/ r,
  @{sys}/devices/@{pci}/vendor rk,
  @{sys}/devices/@{pci}/hwmon/hwmon@{int}/name rk,
  @{sys}/devices/@{pci}/nvme/nvme@{int}/hwmon@{int}/name rk,
  @{sys}/devices/virtual/thermal/thermal_zone@{int}/hwmon@{int}/name rk,
  @{sys}/devices/platform/*/hwmon/hwmon@{int}/name rk,
  @{sys}/devices/virtual/dmi/id/sys_vendor rk,
  @{sys}/devices/virtual/dmi/id/product_name rk,

  include if exists <local/steam-gameoverlayui>
}
