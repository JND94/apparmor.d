abi <abi/5.0>,

include <tunables/global>

@{share_dirs} = @{user_share_dirs}/Steam @{HOME}/.steam/debian-installation
@{steam_library} = @{share_dirs}/steamapps @{MOUNTS}/**/SteamLibrary/steamapps
@{app_dirs} = @{steam_library}/common
@{compatdata} = @{steam_library}/compatdata
@{runtime} = SteamLinuxRuntime SteamLinuxRuntime_sniper SteamLinuxRuntime_soldier SteamLinuxRuntime_4
@{proton_dirs} = @{app_dirs}/Proton*/ @{share_dirs}/compatibilitytools.d/*/
@{client_runtime} = @{share_dirs}/steamrt64/pv-runtime/steam-runtime-steamrt

@{exec_path} = @{client_runtime}/pressure-vessel/libexec/steam-runtime-tools-0/srt-client-container
profile steam-srt-client-container @{client_runtime}/pressure-vessel/libexec/steam-runtime-tools-0/srt-client-container {
  include <abstractions/base>

  @{exec_path} rm,

  signal send set=term peer=steam-srt-launcher-service,

  owner @{client_runtime}/pressure-vessel/lib/@{multiarch}/steam-runtime-tools-0/**.so* rm,

  owner @{client_runtime}/pressure-vessel/libexec/steam-runtime-tools-0/@{multiarch}srt-launcher-service rpx, # steam-srt-launcher-service
  owner @{client_runtime}/run rcx -> run,

  profile run {
    include <abstractions/base>
    include <abstractions/consoles>

    owner @{client_runtime}/run r,

    @{sh_path} r,
    @{bin}/readlink rix,

    owner @{client_runtime}/pressure-vessel/bin/pressure-vessel-unruntime rix,
    owner @{client_runtime}/pressure-vessel/bin/pressure-vessel-wrap rpx, # steam-client-runtime

    include if exists <local/steam-srt-client-container_run>
  }

  include if exists <local/steam-srt-client-container>
}
