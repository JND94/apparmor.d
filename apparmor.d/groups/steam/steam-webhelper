abi <abi/5.0>,

include <tunables/global>

@{domain} = com.valvesoftware.Steam
@{share_dirs} = @{user_share_dirs}/Steam @{HOME}/.steam/debian-installation
@{steam_library} = @{share_dirs}/steamapps @{MOUNTS}/**/SteamLibrary/steamapps
@{app_dirs} = @{steam_library}/common
@{compatdata} = @{steam_library}/compatdata
@{runtime} = SteamLinuxRuntime_sniper SteamLinuxRuntime_soldier SteamLinuxRuntime_4
@{proton_dirs} = @{app_dirs}/Proton* @{share_dirs}/compatibilitytools.d/*/
@{client_runtime} = @{share_dirs}/steamrt64/pv-runtime/steam-runtime-steamrt

@{exec_path} = @{share_dirs}/steamrt64/steamwebhelper
profile steam-webhelper @{share_dirs}/steamrt64/steamwebhelper flags=(attach_disconnected, mediate_deleted) {
  include <abstractions/base>
  include <abstractions/common/chromium>
  include <abstractions/audio-client>
  include <abstractions/dconf-write>
  include <abstractions/fonts>
  include <abstractions/fontconfig-cache-write>
  include <abstractions/graphics>
  include <abstractions/gtk>
  include <abstractions/gschemas>
  include <abstractions/nameservice-strict>
  include <abstractions/ssl_certs>
  include <abstractions/user-dirs>
  include <abstractions/X-strict>

  network netlink raw,
  network inet dgram,
  network inet stream,
  network inet6 dgram,
  network inet6 stream,

  unix type=seqpacket peer=(label=steam-webhelper),
  unix type=stream peer=(label=steam-client-bwrap),
  unix type=seqpacket peer=(label=steam-client-bwrap),

  ptrace (read, trace) peer=steam-client-bwrap//&steam-webhelper,

  signal receive set=kill peer=steam-client-bwrap,
  signal (receive, send) set=term peer=steam-client-bwrap//&steam-webhelper,

  @{exec_path} rix,

  owner @{share_dirs}/linux32/steamerrorreporter rix,
  owner "@{share_dirs}/config/htmlcache/Default/Site Characteristics Database/@{int6}.log" rw,

  owner @{share_dirs}/**.so* rm,
  owner @{lib}/@{multiarch}/*.so* rm,
  owner @{lib}/pressure-vessel/overrides/lib/@{multiarch}/aliases/ r,

  owner @{share_dirs}/ r,
  owner @{share_dirs}/steamui/** r,
  owner @{share_dirs}/clientui/** rk,
  owner @{share_dirs}/config/** r,
  owner @{share_dirs}/appcache/** r,
  owner @{share_dirs}/steamrt64/ r,
  owner @{share_dirs}/steamrt64/extensions/ r,
  owner @{share_dirs}/config/htmlcache/{,**} rwk,
  owner @{share_dirs}/logs/ r,
  owner @{share_dirs}/logs/*.txt rwk,
  owner @{share_dirs}/ubuntu12_64/icudtl.dat r,
  owner @{share_dirs}/ubuntu12_64/chrome*.pak r,
  owner @{share_dirs}/ubuntu12_64/resources.pak r,
  owner @{share_dirs}/steamrt64/locales/ r,
  owner @{share_dirs}/ubuntu12_64/locales/*.pak r,
  owner @{share_dirs}/public/steam_tray_posix.tga rk,
  owner @{share_dirs}/userdata/** r,

  owner @{run}/pressure-vessel/pulse/config rk,

  owner / r,
        /home/ r,
  owner @{HOME}/ r,
  owner @{HOME}/.local/ r,
  owner @{user_share_dirs}/ r,

  @{att}/dev/dri/renderD128 rw,
  owner /dev/shm/ValveIPCSHM_@{uid} rw,
  owner /dev/shm/u@{uid}-ValveIPCSharedObj-Steam rwk,
  owner /dev/shm/u@{uid}-Shm_* rw,
  owner /tmp/steam_chrome_shmem_uid@{uid}_spid@{pid} rw,

  /etc/machine-id r,

  /var/tmp/ r,
  owner /var/pressure-vessel/ldso/ld.so.cache r,

        @{att}@{run}/dbus/system_bus_socket rw,
  owner @{att}@{run}/user/@{uid}/bus rw,
  owner @{att}@{run}/user/@{uid}/pulse/native rw,

        @{run}/host/usr/lib/locale/locale-archive r,
        @{run}/host@{lib}/os-release r,
        @{run}/host@{lib}/gconv/gconv-modules.cache r,
        @{run}/host/usr/share/drirc.d/{,*} r,
        @{run}/host/share/icons/breeze_cursors/** r,
        @{run}/host/fonts/ r,
        @{run}/host/fonts/*/ r,
        @{run}/host/fonts/*/*.{otf,ttf,ttc} r,
        @{run}/host/fonts/encodings/{,**} r,
        @{run}/host@{lib}/**.so* rm, #!!!!!!
        @{run}/host/usr/share/vulkan/implicit_layer.d/*.json r,
        @{run}/host/usr/share/vulkan/icd.d/*.json r,
        @{run}/host/usr/share/libdrm/amdgpu.ids r,
        @{run}/host/fonts-cache/@{hex32}-le64.cache-@{int} r,
  owner @{run}/host/user-fonts-cache/@{hex32}-le64.cache-@{int} r,
  owner @{run}/pressure-vessel/Xauthority r,

        /tmp/ r,
  owner @{tmp}/dumps/assert_*.dmp rw,
  owner @{tmp}/dumps/ rw,
  owner @{tmp}/dumps/@{user}_log.txt rw,

        @{PROC}/ r,
        @{PROC}/pressure/cpu r,
        @{PROC}/pressure/io r,
        @{PROC}/pressure/memory r,
        @{PROC}/filesystems r,
        @{PROC}/version r,
        @{PROC}/sys/fs/inotify/max_user_watches r,
  owner @{PROC}/@{pid}/comm r,
  owner @{PROC}/@{pid}/cmdline r,
  owner @{PROC}/@{pid}/environ r,
  owner @{PROC}/@{pid}/task/ r,
  owner @{PROC}/@{pid}/task/@{tid}/status r,
  owner @{PROC}/@{pid}/fd/ r,
  owner @{PROC}/@{pid}/stat r,
  owner @{PROC}/@{pid}/statm r,
  owner @{PROC}/@{pid}/status r,
  owner @{PROC}/@{pid}/oom_score_adj rw,
  owner @{PROC}/@{pid}/clear_refs w,

  @{sys}/ r,
  @{sys}/kernel/ r,
  @{sys}/devices/@{pci}/drm/ r,
  @{sys}/devices/@{pci}/class r,
  @{sys}/devices/@{pci}/vendor r,
  @{sys}/devices/@{pci}/device r,
  @{sys}/devices/system/cpu/present r,
  @{sys}/devices/system/cpu/cpufreq/policy@{int}/cpuinfo_max_freq r,
  @{sys}/devices/virtual/dmi/id/sys_vendor k,
  @{sys}/devices/virtual/dmi/id/product_name k,

  include if exists <local/steam-webhelper>
}
