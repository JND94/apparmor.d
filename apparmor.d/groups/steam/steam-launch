abi <abi/5.0>,

include <tunables/global>

@{share_dirs} = @{user_share_dirs}/Steam @{HOME}/.steam/debian-installation
@{steam_library} = @{share_dirs}/steamapps @{MOUNTS}/**/SteamLibrary/steamapps
@{app_dirs} = @{steam_library}/common
@{compatdata} = @{steam_library}/compatdata
@{runtime} = SteamLinuxRuntime SteamLinuxRuntime_sniper SteamLinuxRuntime_soldier SteamLinuxRuntime_4
@{proton_dirs} = @{app_dirs}/Proton*/ @{share_dirs}/compatibilitytools.d/*/
@{client_runtime} = @{share_dirs}/steamrt64/pv-runtime/steam-runtime-steamrt

@{exec_path} = @{bin}/steam
profile steam-launch @{bin}/steam {
  include <abstractions/base>
  include <abstractions/consoles>

  @{exec_path} r,

  @{sh_path}         rix,
  @{bin}/cat         rix,
  @{bin}/cmp         rix,
  @{bin}/cp          rix,
  @{bin}/dirname     rix,
  @{bin}/env         rix,
  @{bin}/id          rix,
  @{bin}/readlink    rix,
  @{bin}/rm          rix,
  @{bin}/rmdir       rix,

  @{lib}/steam/bin_steam.sh rix,
  owner @{share_dirs}/steam.sh rpx, #steam

  owner @{client_runtime}/pressure-vessel/bin/steam-runtime-steam-remote rpx,
  owner @{client_runtime}/pressure-vessel/libexec/steam-runtime-tools-0/srt-logger rix,
  owner @{client_runtime}/pressure-vessel/libexec/steam-runtime-tools-0/logger-0.bash r,

  owner @{share_dirs}/bootstrap.tar.xz rw,

  owner @{client_runtime}/pressure-vessel/lib/@{multiarch}/steam-runtime-tools-0/** rm,

  owner @{share_dirs}/logs/ r,
  owner @{share_dirs}/logs/* rwkl,

  owner @{run}/user/@{uid}/srt-fifo.@{rand6}/ rw,
  owner @{run}/user/@{uid}/srt-fifo.@{rand6}/fifo rw,

  owner @{PROC}/@{pid}/fd/@{int} rw,

  include if exists <local/steam-launch>
}
